  "components": [
    {
      "name": "Neutral Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default action; raised neutral fill, 8px radius.",
      "html": "<button class=\"ds-btn\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M23 4v6h-6\"/><path d=\"M1 20v-6h6\"/><path d=\"M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15\"/></svg>Refresh</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 13px;border-radius:var(--radius-xs);font:550 13px/1 var(--font);color:var(--text);background:var(--surface-2);border:1px solid var(--line-2);cursor:pointer;transition:background var(--fast) var(--ease),border-color var(--fast) var(--ease),transform var(--fast) var(--ease)}.ds-btn:hover{background:var(--surface-3);border-color:color-mix(in srgb,var(--text) 18%,transparent)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The page's one primary action; Signal Teal fill.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"M12 5l7 7-7 7\"/></svg>Approve inbox</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 13px;border-radius:var(--radius-xs);font:550 13px/1 var(--font);color:var(--accent-fg);background:var(--accent);border:1px solid transparent;cursor:pointer;transition:background var(--fast) var(--ease),transform var(--fast) var(--ease)}.ds-btn-primary:hover{background:var(--accent-hover)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Halt and destructive steps; danger text on its soft tint.",
      "html": "<button class=\"ds-btn-danger\">Engage halt</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 13px;border-radius:var(--radius-xs);font:550 13px/1 var(--font);color:var(--danger);background:var(--danger-soft);border:1px solid color-mix(in srgb,var(--danger) 28%,transparent);cursor:pointer}.ds-btn-danger:hover{background:color-mix(in srgb,var(--danger) 18%,transparent);border-color:color-mix(in srgb,var(--danger) 42%,transparent)}.ds-btn-danger:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field; inset ground fill, teal ring on focus.",
      "html": "<label class=\"ds-field\"><span>Username</span><input class=\"ds-input\" value=\"admin\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font:550 13px var(--font);color:var(--text-2)}.ds-input{font:400 14px var(--font);color:var(--text);background:var(--bg);border:1px solid var(--line-2);border-radius:var(--radius-xs);min-height:38px;padding:0 12px;transition:border-color var(--fast) var(--ease),box-shadow var(--fast) var(--ease)}.ds-input:hover{border-color:color-mix(in srgb,var(--text) 22%,transparent)}.ds-input:focus{outline:none;border-color:var(--accent-ring);box-shadow:0 0 0 3px var(--accent-soft)}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Sidebar items; active is a raised neutral fill, only the icon turns teal.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item on\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg>Overview<span class=\"ds-count\">1</span></a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"><path d=\"M21 12V7H5a2 2 0 010-4h14v4\"/><path d=\"M3 5v14a2 2 0 002 2h16v-5\"/><path d=\"M18 12a2 2 0 000 4h4v-4h-4z\"/></svg>Wallets</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:4px;width:240px;padding:10px;background:var(--sidebar)}.ds-nav-item{display:flex;align-items:center;gap:12px;height:38px;padding:0 11px;border-radius:var(--radius-xs);font:500 14px var(--font);color:var(--text-2);text-decoration:none;transition:background var(--fast) var(--ease),color var(--fast) var(--ease)}.ds-nav-item:hover{background:var(--hover);color:var(--text)}.ds-nav-item.on{background:var(--surface-2);color:var(--text);box-shadow:inset 0 0 0 1px var(--line)}.ds-nav-item.on svg{color:var(--accent-text)}.ds-nav-item:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-count{margin-left:auto;min-width:20px;height:20px;padding:0 6px;border-radius:999px;display:inline-grid;place-items:center;font:650 11px var(--font);background:var(--warn-soft);color:var(--warn)}"
    },
    {
      "name": "Status Tags",
      "kind": "chip",
      "refersTo": "tag",
      "description": "State as a small dot-led tinted chip.",
      "html": "<span class=\"ds-tag ok\">Available</span> <span class=\"ds-tag warn\">Pinned</span> <span class=\"ds-tag danger\">Quarantined</span> <span class=\"ds-tag\">Idle</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 8px;border-radius:6px;font:550 11.5px var(--font);background:var(--surface-3);color:var(--text-2)}.ds-tag::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}.ds-tag.ok{background:var(--ok-soft);color:var(--ok)}.ds-tag.warn{background:var(--warn-soft);color:var(--warn)}.ds-tag.danger{background:var(--danger-soft);color:var(--danger)}"
    },
    {
      "name": "Balance Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Signature lead panel: quiet 44px figure, muted fraction, pill quick actions.",
      "html": "<section class=\"ds-balance\"><div class=\"ds-bal-top\"><span class=\"ds-bal-label\">Custody equity</span><span class=\"ds-bal-pill\">Observed</span></div><div class=\"ds-amount\">1258<span class=\"frac\">.4200</span><span class=\"unit\">ZKZ</span></div><p class=\"ds-delta\"><strong>Observed on gateway</strong> · 4 wallets</p><div class=\"ds-actions\"><button class=\"ds-quick\">Receive Funds</button><button class=\"ds-quick\">Send Funds</button></div></section>",
      "css": ".ds-balance{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-card);padding:24px 26px 22px;font-family:var(--font);color:var(--text)}.ds-bal-top{display:flex;justify-content:space-between;align-items:center}.ds-bal-label{font:550 14px var(--font);color:var(--text-2)}.ds-bal-pill{font-size:12.5px;color:var(--text-3);padding:4px 10px;border:1px solid var(--line);border-radius:999px}.ds-amount{margin-top:18px;font-size:44px;font-weight:450;letter-spacing:-.035em;line-height:1.05;font-variant-numeric:tabular-nums}.ds-amount .frac{color:var(--text-3)}.ds-amount .unit{font-size:15px;font-weight:550;color:var(--text-3);letter-spacing:0;margin-left:10px}.ds-delta{margin-top:10px;font-size:13px;color:var(--text-3)}.ds-delta strong{color:var(--ok);font-weight:600}.ds-actions{display:flex;gap:8px;margin-top:26px}.ds-quick{height:38px;padding:0 16px;border-radius:999px;font:550 13.5px var(--font);color:var(--text);background:var(--surface-2);border:1px solid var(--line-2);cursor:pointer}.ds-quick:hover{background:var(--surface-3)}.ds-quick:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Three-Ops Strip",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Signature divided panel: one cell per money operation plus halt.",
      "html": "<div class=\"ds-stats\"><div class=\"ds-stat\"><div class=\"k\">Incoming</div><div class=\"c\">RECEIVE_EXTERNAL</div><div class=\"v\">0</div><div class=\"h\">0 landed today</div></div><div class=\"ds-stat\"><div class=\"k\">Outgoing</div><div class=\"c\">SEND_EXTERNAL</div><div class=\"v\">1</div><div class=\"h\">0 landed today</div></div><div class=\"ds-stat\"><div class=\"k\">Halt</div><div class=\"v\">Clear</div><div class=\"h\">Money rails open</div></div></div>",
      "css": ".ds-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;font-family:var(--font);color:var(--text)}.ds-stat{padding:18px 22px 20px;border-left:1px solid var(--line)}.ds-stat:first-child{border-left:0}.ds-stat .k{font-size:13.5px;font-weight:550;color:var(--text-2)}.ds-stat .c{margin-top:1px;font:11px var(--mono);color:var(--text-4);letter-spacing:.02em}.ds-stat .v{margin-top:12px;font-size:30px;font-weight:450;letter-spacing:-.03em;line-height:1.1;font-variant-numeric:tabular-nums}.ds-stat .h{margin-top:4px;font-size:12.5px;color:var(--text-3)}"
    }
  ],
  "narrative": {
    "northStar": "The Night Ledger",
    "overview": "The category-standard dark fintech console, played straight at Mercury's craft bar. A near-black neutral ground carries a stack of surfaces that differ only by small lightness steps and 1px hairlines; nothing glows, nothing is textured, and the single teal accent is spent sparingly. The console reads like a well-kept ledger at 3am: one balance leads, what waits on the operator comes second, and everything else is quiet reference rows.\n\nDensity is moderate and even. Body copy sits at 14px, rows at 13.5px, labels at 12.5px, and the only large type is numerals: the balance figure and the three-ops counts, set in regular weight with muted fractional digits so the number reads as a measurement rather than a headline. State is spoken in small marks (8px dots with a soft halo, 22px tinted chips) rather than in colored panels. Light theme is a full peer, not an inversion: every role has its own tuned value under `[data-theme=\"light\"]`.\n\nThe system is constrained by the node's CSP: system font stacks only, no remote assets, every icon an inline 24-unit stroke SVG.",
    "keyCharacteristics": [
      "Near-black neutral ground; depth by lightness steps and hairlines, not shadow.",
      "One teal accent for primary action, focus, and the active mark.",
      "Large panel radii (14px) against tighter control radii (8px).",
      "Big figures in regular weight (450) with muted fractions and tabular numerals.",
      "State colour as dots and soft chips, never as filled surfaces.",
      "Dark and light themes tokenised as equal peers."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Teal is reserved for primary action, focus, and the active mark. Active navigation is a raised neutral fill with a hairline inset; only its icon turns teal. Never wash a row, nav item, or panel in accent.",
        "section": "colors"
      },
      {
        "name": "The Small State Rule",
        "body": "State hues appear at full strength only as dots, chip text, or icon glyphs, always over their own soft tint. A whole panel never turns green, amber, or red; banners carry state as a tinted line of truth, not a coloured block.",
        "section": "colors"
      },
      {
        "name": "The Reading Ink Rule",
        "body": "Ink 4 is for placeholders, disabled controls, and keyboard hints. Text an operator must read uses Ink 3 or stronger.",
        "section": "colors"
      },
      {
        "name": "The Quiet Figure Rule",
        "body": "Large numbers are set in regular weight (450) with tabular numerals and a muted fraction. Never bold a figure to make it important; size and position already do that.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels, buttons, chips and headings are sentence case at normal tracking. Machine identifiers (operation codes, addresses) appear in mono as data, beneath their human label, never as a decorative line above a heading.",
        "section": "typography"
      },
      {
        "name": "The Lead and Reference Rule",
        "body": "One element leads each page (on Overview, the full-width balance panel). What needs the operator sits next; everything else is rows inside panels, not a wall of equal tiles.",
        "section": "layout"
      },
      {
        "name": "The Lightness Ladder Rule",
        "body": "Depth on the page is ground, then surface, then raised, then high. Reach for the next step before reaching for a shadow; shadows belong only to layers that float.",
        "section": "elevation"
      },
      {
        "name": "The Two Radii Rule",
        "body": "A container rounds at 14px, the control inside it at 8px. Do not shrink panels toward control radii or round controls toward panels.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do separate surfaces with a lightness step and a 1px hairline before considering a shadow.",
      "Do spend Signal Teal only on primary action, focus, and the active nav icon.",
      "Do set figures at weight 450 with tabular numerals and a muted fraction.",
      "Do carry state as an 8px dot or a 22px tinted chip, in the state hue over its 12% tint.",
      "Do round containers at 14px and controls at 8px.",
      "Do define every new colour role for both `:root/[data-theme=\"dark\"]` and `[data-theme=\"light\"]`.",
      "Do keep primary phone actions at 44px and keep every surface reflowing to 320px."
    ],
    "donts": [
      "Don't wash active navigation, rows, or panels in accent; active is a raised neutral fill.",
      "Don't build a tile wall where every number gets an equal card; one figure leads.",
      "Don't fill a panel or banner with a solid state colour.",
      "Don't load a web font or remote asset; the system stacks are required by CSP and tests.",
      "Don't set reading text in Ink 4.",
      "Don't put uppercase eyebrows or kicker lines above headings."
    ]
  }
}