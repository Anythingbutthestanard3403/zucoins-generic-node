{
  "name": "zucoins-generic-node",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @zucoins/generic-node-ui build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:boundaries": "vitest run packages/node-core/test/boundaries.test.ts packages/node-core/test/manifest-boundaries.test.ts packages/generic-node-contracts/src/scan/dependency-boundary.test.ts packages/generic-node-contracts/src/scan/generic-core.scan-gate.test.ts packages/generic-node-contracts/src/scan/reporting-serializer-confinement.census.test.ts",
    "build:tsc": "tsc -b",
    "typecheck": "pnpm build:tsc && pnpm --filter @zucoins/generic-node typecheck:tests",
    "release:validate": "node scripts/release-targets.mjs validate",
    "release:test": "node --test scripts/release-targets-strict-dual.test.mjs scripts/money-path-scan.test.mjs scripts/release-targets.test.mjs docs/operations/annotate-forged-expired-t0-releases.test.mjs",
    "release:fence": "node scripts/release-targets-strict-dual.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.64.0",
    "globals": "^14.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "@types/node": "22.20.1"
  }
}
