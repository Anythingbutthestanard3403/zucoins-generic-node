  "devDependencies": {
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.64.0",
    "globals": "^14.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "@types/node": "22.20.1"
