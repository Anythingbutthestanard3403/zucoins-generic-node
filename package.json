{
  "name": "zucoins-generic-node",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @zucoins/generic-node-ui build && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
