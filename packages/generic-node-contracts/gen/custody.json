    "importedDestinationInsert": "REJECT",
    "recoveryFields": "SET_TOGETHER_AFTER_SUCCESSFUL_AUDITED_EXPORT_AND_NEVER_CLEAR",
    "selectionRecheck": "RECHECK_ALL_CONJUNCTS_AT_EXECUTION_TIME",
