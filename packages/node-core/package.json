    "./credential": "./dist/credential/index.js",
    "./data": "./dist/data/index.js",
    "./gateway": "./dist/gateway/index.js",
    "./http": "./dist/http/index.js",
    "./net": "./dist/net/index.js",
    "./observability": "./dist/observability/index.js",
    "./totp": "./dist/totp/index.js",
    "./observation": "./dist/observation/index.js",
    "./operator": "./dist/operator/index.js",
    "./move": "./dist/move/index.js",
    "./proof-body": "./dist/proof-body/index.js",
    "./protocol": "./dist/protocol/index.js",
    "./push": "./dist/push/index.js",
    "./reporting": "./dist/reporting/index.js",
    "./signing-keys": "./dist/signing-keys/index.js",
    "./vault": "./dist/vault/index.js",
    "./verifier": "./dist/verifier/index.js",
    "./verifier/consumer": "./dist/verifier/consumer/index.js",
