        "/apps/generic-node/**",
        "/packages/node-core/**",
        "/pnpm-lock.yaml",
        "/pnpm-workspace.yaml",
        "/tsconfig.base.json"
      ],
      "healthGate": {
        "path": "/health/ready",
        "expectedStatus": 200,
        "stabilization": "provider-healthcheck"
      },
      "migrationRequired": true,
      "approval": "riley-explicit-in-session",
      "liveAcceptance": "not-required-no-custody",
      "rollbackRef": "release/README.md#generic-node-boundary",
      "externalBinding": {
        "driftCheck": "manual-riley-gated-read-only",
        "logicalService": "generic-node",
        "logicalEnvironment": "production",
        "sourceMode": "repository",
        "branch": "main",
        "configPath": "apps/generic-node/railway.json"
      }
    },
